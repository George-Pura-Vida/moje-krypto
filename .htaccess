DirectoryIndex index.php
Options -Indexes
<FilesMatch "^(config\.local\.php|\.env.*|\.gitignore|\.htaccess|config\.example\.php)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
</IfModule>

# Prevent direct access to Git metadata and hidden paths
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(git|github)(/|$) - [F,L,NC]
RewriteRule (^|/)(storage)(/|$) - [F,L,NC]
</IfModule>
